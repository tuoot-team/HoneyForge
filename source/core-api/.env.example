# HoneyForge core-api - скопируйте в .env

DEBUG=true
# без Docker/Postgres ставьте true (локальная SQLite)
USE_SQLITE=true

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=honeyforge
POSTGRES_PASSWORD=honeyforge
POSTGRES_DB=honeyforge

REDIS_URL=redis://localhost:6379/0

OPERATOR_PASSWORD=change-me
OPERATOR_TOKEN_SECRET=dev-change-me-operator-secret

PUBLIC_BASE_URL=http://localhost
AGENT_STALE_MINUTES=5
PAIRING_TTL_MINUTES=15
