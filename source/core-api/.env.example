# HoneyForge core-api - скопируйте в .env

DEBUG=true
# без Docker/Postgres ставьте true (локальная SQLite)
USE_SQLITE=true

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=honeyforge
POSTGRES_PASSWORD=honeyforge
POSTGRES_DB=honeyforge

# Bootstrap superadmin при пустой таблице users
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=change-me
OPERATOR_TOKEN_SECRET=dev-change-me-operator-secret

# Адрес центра, который видит хост ловушки (для deploy, если center_url не передан)
PUBLIC_BASE_URL=http://localhost
AGENT_STALE_MINUTES=5
PAIRING_TTL_MINUTES=15

# TLS (Let's Encrypt). Пустой TLS_DOMAIN = только HTTP :80 / :8088.
# Нужен публичный DNS на этот хост и открытый порт 80 (ACME http-01).
# TLS_DOMAIN=honeypot.example.com
# TLS_EMAIL=admin@example.com
# После выпуска: PUBLIC_BASE_URL=https://honeypot.example.com
# CLI: API_BASE=https://honeypot.example.com:8088
TLS_DOMAIN=
TLS_EMAIL=

# Опциональный mTLS на канале агента/курьера (:443). Operator :8088 без client-cert.
# 1) ./scripts/gen-mtls.sh  →  ./mtls/ca.crt + client.crt/key
# 2) положить ca.crt в source/core-api/mtls/ (volume в compose)
# 3) на ловушке: TLS_CLIENT_CERT / TLS_CLIENT_KEY (+ TLS_CA при необходимости)
# Пустой файл / отсутствие mtls/ca.crt = mTLS выключен, как раньше.
# MTLS_CA_FILE=/etc/honeyforge/mtls/ca.crt

# Пакеты FS для fake shell (каталог и лимит загрузки)
# FS_PACKS_DIR=./fs-packs
# FS_PACK_MAX_BYTES=33554432

# Образы High VM (OVA; крупные файлы, не в git)
# VM_IMAGES_DIR=./vm-images
# VM_IMAGES_MAX_BYTES=85899345920

# Builtin personality packs (JSON пресеты mask/banner/HTTP)
# PERSONALITY_PACKS_DIR=../personality-packs
