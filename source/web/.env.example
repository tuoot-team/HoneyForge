VITE_DEBUG=false
# Куда dev-сервер проксирует /api. Без хвоста /api/v1.
# Тот же адрес, что API_BASE у CLI (source/cli/.env).
# Локальный compose: http://127.0.0.1:8088
# Прямой uvicorn без nginx: http://127.0.0.1:8000
API_BASE=http://127.0.0.1:8088
# Зашивается в сборку панели. Пусто = браузер ходит в /api того же origin (:80/:443).
VITE_API_BASE=
